# SECRETOS DEL SERVIDOR (solo para la función del bot). NUNCA van en index.html.
# Copia este archivo como .env y rellénalo. El .env real está en .gitignore.
# Para desplegar: supabase secrets set --env-file .env

# Supabase inyecta SUPABASE_URL automáticamente dentro de las Edge Functions.
# Si tu panel muestra SUPABASE_SECRET_KEY en lugar de SERVICE_ROLE_KEY,
# usa el nombre que corresponda en index.ts.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=            # texto largo y aleatorio que tú inventas
WA_APP_SECRET=              # App Secret de tu app en Meta
WA_ACCESS_TOKEN=            # token permanente (usuario del sistema)

# Alertas (opcional)
TELEGRAM_BOT_TOKEN=
